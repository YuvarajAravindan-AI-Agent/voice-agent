# Deepgram (STT) - https://console.deepgram.com
DEEPGRAM_API_KEY=

# Rime (TTS) - https://rime.ai
RIME_API_KEY=
RIME_VOICE_ID=cove

# LLM - Gemini via OpenAI-compat endpoint (gemini-dify-embedding key, GCP
# project google-anti-gravity)
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
