# Deepgram (STT) - https://console.deepgram.com
DEEPGRAM_API_KEY=

# TTS provider switch: rime-http | rime-ws | gemini
TTS_PROVIDER=rime-http

# Rime (TTS) - https://rime.ai
RIME_API_KEY=
RIME_VOICE_ID=cove
RIME_MODEL=mistv2

# Gemini TTS (only when TTS_PROVIDER=gemini; also used by compare_tts.py)
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore

# LLM - Gemini via the native google-genai client (gemini-dify-embedding key, GCP
# project google-anti-gravity)
LLM_API_KEY=
LLM_MODEL=gemini-flash-lite-latest

MAX_CALL_DURATION_SECS=180

# Odoo tools bridge (unchanged from before)
ODOO_TOOLS_URL=http://127.0.0.1:8790
ODOO_TOOLS_TOKEN=
